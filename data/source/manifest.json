{
  "$schema": "../../schema/manifest.schema.json",
  "schemaVersion": 1,
  "dataVersion": "0.1.0-example",
  "airport": {
    "iata": "PKX",
    "icao": "ZBAD",
    "name": "北京大兴国际机场",
    "nameEn": "Beijing Daxing International Airport",
    "shortName": "BDIA",
    "verified": false
  },
  "projection": {
    "type": "local-enu",
    "_comment": "全部源数据使用本地米制坐标系绘制：x = 正东(米)，y = 正北(米)。不要用经纬度画图。",
    "origin": {
      "lat": 39.5098,
      "lon": 116.4109
    },
    "axis": {
      "x": "east",
      "y": "north",
      "unit": "meter"
    },
    "metersPerDegree": {
      "lat": 111320,
      "lon": 85882
    },
    "_metersPerDegreeComment": "北京纬度约 39.51°，1° 经度 ≈ 111320 × cos(39.51°) ≈ 85882 m。直接用经纬度算距离会有约 30% 误差（Web Mercator 尺度因子 1/cos(φ) ≈ 1.296）。",
    "geojsonCoordinateOrder": "xy",
    "_geojsonCoordinateOrderComment": "★ 本项目中所有 GeoJSON coordinates 一律是 [x, y] = [东, 北] 米，绝对不是 [lon, lat]！只有 anchors.json 的 wgs84 字段是 [lon, lat]。"
  },
  "bbox": {
    "_comment": "所有源数据坐标必须落在此范围内，防止误画飞出。航站楼核心区约 1km 量级。",
    "minX": -700,
    "maxX": 700,
    "minY": -700,
    "maxY": 700,
    "unit": "meter"
  },
  "levels": {
    "_comment": "★ 楼层角色(roles)是按公开资料推测的，必须对照官方平面图核实后把 verified 改为 true。校验器会对 verified:false 的楼层给出 INFO 提示。order 越大越靠上。",
    "L5F": {
      "order": 7,
      "elevation": 24,
      "name": "五层",
      "nameEn": "Level 5",
      "roles": [
        "dining",
        "observation"
      ],
      "verified": false,
      "drawn": false
    },
    "L4F": {
      "order": 6,
      "elevation": 18,
      "name": "四层",
      "nameEn": "Level 4",
      "roles": [
        "departure",
        "checkin",
        "security",
        "airside"
      ],
      "verified": false,
      "drawn": false
    },
    "L3F": {
      "order": 5,
      "elevation": 12,
      "name": "三层",
      "nameEn": "Level 3",
      "roles": [
        "departure",
        "airside",
        "gates",
        "transit"
      ],
      "verified": false,
      "drawn": true
    },
    "L2F": {
      "order": 4,
      "elevation": 6,
      "name": "二层",
      "nameEn": "Level 2",
      "roles": [
        "arrival",
        "baggage_claim",
        "transit"
      ],
      "verified": false,
      "drawn": false
    },
    "L1F": {
      "order": 3,
      "elevation": 0,
      "name": "一层",
      "nameEn": "Level 1",
      "roles": [
        "arrival",
        "baggage_claim",
        "landside",
        "ground_transport"
      ],
      "verified": false,
      "drawn": false
    },
    "B1": {
      "order": 2,
      "elevation": -6.5,
      "name": "地下一层",
      "nameEn": "B1",
      "roles": [
        "rail",
        "landside",
        "parking"
      ],
      "verified": false,
      "drawn": false
    },
    "B2": {
      "order": 1,
      "elevation": -13,
      "name": "地下二层",
      "nameEn": "B2",
      "roles": [
        "parking",
        "rail"
      ],
      "verified": false,
      "drawn": false
    }
  },
  "regionKinds": {
    "_comment": "★ 区域 = 隔离区标记。【不参与寻路】—— 寻路完全由 paths.geojson 决定。区域只负责：① 承载 zone 语义 ② 判断通行线有没有画到区域外 ③ 判断设施落在哪个区域上 ④ 渲染着色。",
    "_floor": "★ 楼板 = 「可通行面」区域 − 「挑空」障碍物。只有 kind = walkable 的区域参与画楼板；别的种类（候机区/走廊/指廊…）只是语义标签，不参与。一个楼层一个可通行面就够，形状可以很复杂（航站楼本来就不是矩形）。",
    "walkable": {
      "name": "可通行面",
      "nameEn": "Walkable area"
    },
    "concourse": {
      "name": "候机区",
      "nameEn": "Concourse"
    },
    "lobby": {
      "name": "厅",
      "nameEn": "Lobby"
    },
    "corridor": {
      "name": "走廊",
      "nameEn": "Corridor"
    },
    "pier": {
      "name": "指廊",
      "nameEn": "Pier"
    },
    "hall": {
      "name": "大厅",
      "nameEn": "Hall"
    },
    "queue": {
      "name": "排队区",
      "nameEn": "Queue area"
    },
    "bridge": {
      "name": "连廊",
      "nameEn": "Bridge"
    },
    "platform": {
      "name": "站台",
      "nameEn": "Platform"
    },
    "staff": {
      "name": "员工区",
      "nameEn": "Staff area"
    }
  },
  "pathKinds": {
    "_comment": "通行线种类。通行线是【唯一的寻路图】—— 端点、顶点、交叉点都是图节点，两条线交叉即连通。区域从「寻路图」降级为「隔离区标记 + 几何约束」。",
    "spine": {
      "name": "主通道",
      "nameEn": "Spine"
    },
    "corridor": {
      "name": "走廊",
      "nameEn": "Corridor"
    },
    "pier": {
      "name": "指廊通道",
      "nameEn": "Pier walkway"
    },
    "branch": {
      "name": "支线",
      "nameEn": "Branch"
    },
    "queue": {
      "name": "排队折线",
      "nameEn": "Queue line"
    },
    "walkway": {
      "name": "自动步道",
      "nameEn": "Travelator"
    },
    "staff": {
      "name": "员工通道",
      "nameEn": "Staff route"
    }
  },
  "obstacleKinds": {
    "_comment": "障碍物种类。障碍物没有名字、没有类别 —— 它们不是设施，只是要从可通行面里扣掉的区域，不该被搜到、也不该成为导航目的地。",
    "column": {
      "name": "柱子",
      "nameEn": "Column"
    },
    "counter": {
      "name": "柜台",
      "nameEn": "Counter"
    },
    "equipment": {
      "name": "设备",
      "nameEn": "Equipment"
    },
    "planter": {
      "name": "绿植",
      "nameEn": "Planter"
    },
    "furniture": {
      "name": "固定家具",
      "nameEn": "Fixed furniture"
    },
    "stairwell": {
      "name": "楼梯井",
      "nameEn": "Stairwell"
    },
    "shaft": {
      "name": "管井",
      "nameEn": "Shaft"
    },
    "void": {
      "name": "挑空",
      "nameEn": "Void"
    },
    "blocked": {
      "name": "封闭区域",
      "nameEn": "Blocked area"
    }
  },
  "zones": {
    "_comment": "隔离区。zone 只能通过连接件(connector)跨越，见 zoneRules。这是机场导航与商场导航的根本区别。",
    "landside": {
      "name": "非隔离区（安检前）",
      "nameEn": "Landside",
      "color": "#8FA3B0",
      "public": true,
      "order": 1
    },
    "transit": {
      "name": "中转区",
      "nameEn": "Transit",
      "color": "#C9A227",
      "public": true,
      "order": 2
    },
    "security": {
      "name": "安检区",
      "nameEn": "Security",
      "color": "#D98C3F",
      "public": true,
      "order": 3
    },
    "airside_domestic": {
      "name": "国内隔离区",
      "nameEn": "Airside (Domestic)",
      "color": "#3F8FD9",
      "public": true,
      "order": 4
    },
    "airside_intl": {
      "name": "国际隔离区",
      "nameEn": "Airside (International)",
      "color": "#7B5ED9",
      "public": true,
      "order": 5
    },
    "airside_transit": {
      "name": "国际中转隔离区",
      "nameEn": "Airside (Transit)",
      "color": "#B05EC9",
      "public": true,
      "order": 6
    },
    "staff": {
      "name": "工作人员区",
      "nameEn": "Staff only",
      "color": "#5A5A5A",
      "public": false,
      "order": 7
    },
    "restricted": {
      "name": "禁止进入",
      "nameEn": "Restricted",
      "color": "#3A3A3A",
      "public": false,
      "order": 8
    }
  },
  "zoneRules": {
    "_comment": "允许的 zone 跨越方式。校验器用这张表判定「隔离区泄漏」：两个不同 zone 的可通行面如果直接相邻，或用了表外的连接件类型跨越，即为 ERROR。",
    "_direction": "★ 这是有向的。landside → airside_domestic 必须过安检；airside_domestic → landside 是到达出口，单向自由通行。反过来放行就等于没安检。",
    "allowedTransitions": [
      {
        "from": "landside",
        "to": "airside_domestic",
        "via": [
          "security"
        ],
        "note": "国内出发安检"
      },
      {
        "from": "landside",
        "to": "airside_intl",
        "via": [
          "security",
          "immigration",
          "customs"
        ],
        "note": "国际出发：安检 + 出境边检"
      },
      {
        "from": "landside",
        "to": "transit",
        "via": [
          "security",
          "transfer_desk"
        ],
        "note": "中转旅客进入中转区"
      },
      {
        "from": "airside_domestic",
        "to": "landside",
        "via": [
          "exit"
        ],
        "note": "★ 国内到达：单向出口，无需查验。只能这个方向，反向就是隔离区泄漏"
      },
      {
        "from": "airside_intl",
        "to": "landside",
        "via": [
          "immigration",
          "customs",
          "quarantine"
        ],
        "note": "国际到达：入境边检 + 海关"
      },
      {
        "from": "transit",
        "to": "airside_domestic",
        "via": [
          "security",
          "transfer_desk"
        ],
        "note": "中转国内：中转安检"
      },
      {
        "from": "transit",
        "to": "airside_intl",
        "via": [
          "security",
          "transfer_desk",
          "immigration"
        ],
        "note": "中转国际：出境边检"
      },
      {
        "from": "airside_domestic",
        "to": "transit",
        "via": [
          "transfer_desk"
        ],
        "note": "国内转国际：回到中转区"
      },
      {
        "from": "airside_intl",
        "to": "transit",
        "via": [
          "transfer_desk",
          "immigration"
        ],
        "note": "国际转国际"
      },
      {
        "from": "airside_transit",
        "to": "transit",
        "via": [
          "transfer_desk"
        ],
        "note": "中转区内部"
      }
    ]
  },
  "connectorTypes": {
    "_comment": "连接件类型。horizontal=true 表示同层连接（如步行道），false 表示跨层或跨区。",
    "escalator": {
      "name": "扶梯",
      "nameEn": "Escalator",
      "horizontal": false,
      "accessible": false,
      "alignTolerance": 3,
      "category": "vertical"
    },
    "elevator": {
      "name": "电梯",
      "nameEn": "Elevator",
      "horizontal": false,
      "accessible": true,
      "alignTolerance": 1.5,
      "category": "vertical"
    },
    "stairs": {
      "name": "楼梯",
      "nameEn": "Stairs",
      "horizontal": false,
      "accessible": false,
      "alignTolerance": 2,
      "category": "vertical"
    },
    "travelator": {
      "name": "自动步道",
      "nameEn": "Travelator",
      "horizontal": true,
      "accessible": true,
      "alignTolerance": 5,
      "category": "horizontal"
    },
    "ramp": {
      "name": "坡道",
      "nameEn": "Ramp",
      "horizontal": false,
      "accessible": true,
      "alignTolerance": 3,
      "category": "vertical"
    },
    "apm": {
      "name": "捷运",
      "nameEn": "APM",
      "horizontal": true,
      "accessible": true,
      "alignTolerance": 50,
      "category": "transit"
    },
    "shuttle": {
      "name": "摆渡车",
      "nameEn": "Shuttle bus",
      "horizontal": true,
      "accessible": true,
      "alignTolerance": 200,
      "category": "transit"
    },
    "train": {
      "name": "轨道",
      "nameEn": "Rail",
      "horizontal": true,
      "accessible": true,
      "alignTolerance": 200,
      "category": "transit"
    },
    "security": {
      "name": "安检",
      "nameEn": "Security",
      "horizontal": true,
      "accessible": true,
      "alignTolerance": 200,
      "category": "process",
      "oneWay": true,
      "_oneWay": "★ 查验类通道天然单向。默认双向的话，旅客会被规划出「倒着走回安检外面」的路线"
    },
    "immigration": {
      "name": "边检",
      "nameEn": "Immigration",
      "horizontal": true,
      "accessible": true,
      "alignTolerance": 200,
      "category": "process",
      "oneWay": true
    },
    "customs": {
      "name": "海关",
      "nameEn": "Customs",
      "horizontal": true,
      "accessible": true,
      "alignTolerance": 200,
      "category": "process",
      "oneWay": true
    },
    "quarantine": {
      "name": "检验检疫",
      "nameEn": "Quarantine",
      "horizontal": true,
      "accessible": true,
      "alignTolerance": 200,
      "category": "process",
      "oneWay": true
    },
    "transfer_desk": {
      "name": "中转柜台",
      "nameEn": "Transfer desk",
      "horizontal": true,
      "accessible": true,
      "alignTolerance": 200,
      "category": "process",
      "oneWay": false,
      "_oneWay": "柜台是走过去办事，不是单向通道 —— 两端都能走"
    },
    "exit": {
      "name": "到达出口",
      "nameEn": "Arrival exit",
      "horizontal": true,
      "accessible": true,
      "alignTolerance": 200,
      "category": "process",
      "oneWay": true
    },
    "boarding": {
      "name": "登机口",
      "nameEn": "Boarding gate",
      "horizontal": true,
      "accessible": true,
      "alignTolerance": 200,
      "category": "process"
    }
  },
  "timeModel": {
    "_comment": "★ 全部为占位示意值，必须用实测数据校准。-- 秒 --",
    "walkSpeed": {
      "default": 1.25,
      "withLuggage": 1,
      "wheelchair": 0.9,
      "elderly": 0.95,
      "withChildren": 0.9,
      "rushing": 1.6
    },
    "connectorTime": {
      "escalator": {
        "base": 3,
        "perLevel": 10,
        "note": "含进出扶梯时间"
      },
      "elevator": {
        "base": 8,
        "wait": 45,
        "perLevel": 8,
        "note": "wait 为平均等待，P90 建议取 90s"
      },
      "stairs": {
        "base": 2,
        "perLevel": 15
      },
      "travelator": {
        "base": 3,
        "speed": 0.75
      },
      "ramp": {
        "base": 2,
        "perLevel": 20
      },
      "apm": {
        "base": 60,
        "wait": 120,
        "perRide": 180
      },
      "shuttle": {
        "base": 60,
        "wait": 300,
        "perRide": 600
      },
      "train": {
        "base": 60,
        "wait": 240,
        "perRide": 480
      }
    },
    "processTime": {
      "security": {
        "wait": 480,
        "waitPeak": 1080,
        "service": 60,
        "perLane": 12
      },
      "immigration": {
        "wait": 300,
        "waitPeak": 900,
        "service": 45
      },
      "customs": {
        "wait": 60,
        "service": 30
      },
      "quarantine": {
        "wait": 30,
        "service": 30
      },
      "transfer_desk": {
        "wait": 120,
        "service": 180
      },
      "checkin": {
        "wait": 300,
        "service": 180
      },
      "baggage_drop": {
        "wait": 180,
        "service": 120
      },
      "baggage_claim": {
        "wait": 900,
        "service": 0,
        "note": "抵达后到行李出来的平均等待，航班差异极大"
      }
    }
  },
  "scenarios": {
    "_comment": "★ 两层规划器的上层：任务图。上层是业务规则（会变），下层是几何图（不会变）。required=false 的步骤由 when 条件决定是否插入。",
    "dep-domestic": {
      "name": "国内出发",
      "nameEn": "Domestic Departure",
      "zonePath": [
        "landside",
        "airside_domestic"
      ],
      "steps": [
        {
          "id": "enter",
          "category": "entrance",
          "required": true
        },
        {
          "id": "checkin",
          "category": "checkin",
          "required": false,
          "when": "!checkedIn || needBaggageDrop"
        },
        {
          "id": "bagdrop",
          "category": "baggage_drop",
          "required": false,
          "when": "needBaggageDrop"
        },
        {
          "id": "security",
          "category": "security",
          "required": true
        },
        {
          "id": "gate",
          "category": "gate",
          "required": true,
          "dynamic": "boardingGate"
        }
      ]
    },
    "dep-international": {
      "name": "国际出发",
      "nameEn": "International Departure",
      "zonePath": [
        "landside",
        "airside_intl"
      ],
      "steps": [
        {
          "id": "enter",
          "category": "entrance",
          "required": true
        },
        {
          "id": "checkin",
          "category": "checkin",
          "required": false,
          "when": "!checkedIn || needBaggageDrop"
        },
        {
          "id": "bagdrop",
          "category": "baggage_drop",
          "required": false,
          "when": "needBaggageDrop"
        },
        {
          "id": "security",
          "category": "security",
          "required": true
        },
        {
          "id": "immigration",
          "category": "immigration",
          "required": true
        },
        {
          "id": "gate",
          "category": "gate",
          "required": true,
          "dynamic": "boardingGate"
        }
      ]
    },
    "arr-domestic": {
      "name": "国内到达",
      "nameEn": "Domestic Arrival",
      "zonePath": [
        "airside_domestic",
        "landside"
      ],
      "steps": [
        {
          "id": "arrive",
          "category": "gate",
          "required": true
        },
        {
          "id": "baggage_claim",
          "category": "baggage_claim",
          "required": false,
          "when": "hasCheckedBaggage"
        },
        {
          "id": "exit",
          "category": "exit",
          "required": true
        }
      ]
    },
    "arr-international": {
      "name": "国际到达",
      "nameEn": "International Arrival",
      "zonePath": [
        "airside_intl",
        "landside"
      ],
      "steps": [
        {
          "id": "arrive",
          "category": "gate",
          "required": true
        },
        {
          "id": "quarantine",
          "category": "quarantine",
          "required": false,
          "when": "requiresQuarantine"
        },
        {
          "id": "immigration",
          "category": "immigration",
          "required": true
        },
        {
          "id": "baggage_claim",
          "category": "baggage_claim",
          "required": false,
          "when": "hasCheckedBaggage"
        },
        {
          "id": "customs",
          "category": "customs",
          "required": true
        },
        {
          "id": "exit",
          "category": "exit",
          "required": true
        }
      ]
    },
    "transit-domestic-domestic": {
      "name": "国内中转国内",
      "nameEn": "Domestic to Domestic Transit",
      "zonePath": [
        "airside_domestic",
        "transit",
        "airside_domestic"
      ],
      "steps": [
        {
          "id": "arrive",
          "category": "gate",
          "required": true
        },
        {
          "id": "transfer",
          "category": "transfer_desk",
          "required": false,
          "when": "!hasBoardingPass"
        },
        {
          "id": "security",
          "category": "security",
          "required": true
        },
        {
          "id": "gate",
          "category": "gate",
          "required": true,
          "dynamic": "boardingGate"
        }
      ]
    },
    "transit-international-domestic": {
      "name": "国际中转国内（入境）",
      "nameEn": "International to Domestic Transit",
      "zonePath": [
        "airside_intl",
        "landside",
        "airside_domestic"
      ],
      "steps": [
        {
          "id": "arrive",
          "category": "gate",
          "required": true
        },
        {
          "id": "immigration",
          "category": "immigration",
          "required": true
        },
