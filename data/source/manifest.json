  "zoneTransitions": {
    "_why": "从一个隔离区走到另一个隔离区，【必须穿过哪些类别的设施】。这就是\"门\"的规则本身：不是\"能不能穿\"，而是\"必须穿哪一个\"。寻路时只允许穿过这些类别的门禁设施；穿完之后还会逐条核对，少穿一个就报出来，不会悄悄给出一条绕过去的路。",
    "_order": "按 [from, to] 精确匹配，找不到就说明这两个区之间不该直接通行。",
    "rules": [
      {
        "from": "landside",
        "to": "airside_domestic",
        "via": [
          "security"
        ],
        "label": "公共区 → 国内隔离区"
      },
      {
        "from": "landside",
        "to": "airside_intl",
        "via": [
          "security",
          "customs"
        ],
        "label": "公共区 → 国际隔离区"
      },
      {
        "from": "airside_intl",
        "to": "airside_domestic",
        "via": [
          "customs"
        ],
        "label": "国际隔离区 → 国内隔离区（中转入境）"
      },
      {
        "from": "airside_domestic",
        "to": "landside",
        "via": [
          "domestic_exit"
        ],
        "label": "国内隔离区 → 公共区（到达）"
      },
      {
        "from": "airside_intl",
        "to": "landside",
        "via": [
          "customs",
          "intl_exit"
        ],
        "label": "国际隔离区 → 公共区（到达）"
      },
      {
        "from": "airside_domestic",
        "to": "airside_intl",
        "via": [
          "security",
          "customs"
        ],
        "label": "国内隔离区 → 国际隔离区（中转出境）"
      }
    ],
    "_sameZone": "同区之间【不允许穿过任何门禁设施】—— 没有理由在同一个区里过一次安检。"
  }
