  "thresholds": {
    "_comment": "校验阈值。校验器从 manifest 读取，不要硬编码在脚本里。",
    "doorTolerance": 0.5,
    "connectorEndpointTolerance": 1,
    "polygonTouchTolerance": 0.05,
    "minPolygonArea": 0.5,
    "minAreaFacility": 1,
    "anchorCountMin": 3,
    "anchorResidualMax": 2,
    "anchorScaleRange": [
      0.9,
      1.1
    ],
    "duplicateFacilityDistance": 1,
    "pathOnRegionTolerance": 0.5,
    "_pathOnRegionTolerance": "通行线采样点必须落在同层同 zone 的区域面内。0.5m 容忍贴着边界画的情况。",
    "pathSampleStep": 2,
    "connectorOnPathTolerance": 0.5,
    "pathNearMissMin": 0.05,
    "pathNearMissMax": 2,
    "pathDanglingAnchorDistance": 15,
    "_pathDanglingAnchorDistance": "悬空端点判定半径（米）。★ 要 ≥ 指廊半宽：指廊通常 28m 宽，中线到两侧登机口约 12~14m，阈值太小会把正常的指廊末端全报成悬空。",
    "areaAttachTolerance": 1,
    "_areaAttachTolerance": "★ 面状设施可达性：通行线必须吸附到它边缘的这个距离内。线画在区域里、房间画在区域外，两者在墙上相遇。",
    "poiPathTolerance": 5,
    "_poiPathTolerance": "★ 点状设施可达性：必须有通行线经过它这个距离内。设成 5m 意味着大指廊（28m 宽）需要给两侧登机口各拉一条支线 —— 编辑器有「一键生成支线」。",
    "verticalGroupTolerance": 0.05,
    "_verticalGroupTolerance": "★ 同一个 verticalGroup 的各层成员，坐标必须一致到这个容差内。这是整个模型里唯一「跨楼层同一个位置」的地方 —— 对不上，3D 里的垂直路径就是斜的。",
    "nodeMergeTolerance": 0.5,
    "pathTouchTolerance": 0.02,
    "_pathTouchToleranceWhy": "端点离另一条通行线多近算「接上了」，会在这里生成路口。必须和【编辑器坐标精度】对齐：坐标存 2 位小数（1 厘米），所以这个值要比 1 厘米大一档，取 2 厘米。实测所有端点里，吸附产生的偏差全在 2 厘米内（669 处），2~20 厘米这一段是空的 —— 没有自然情况落在这里，阈值卡得正好。★ 如果以后改坐标精度（比如存 3 位小数），这个值要跟着调。"
  },
  "facilityCategories": {
    "_comment": "设施类别。点状设施（登机口、饮水）和面状设施（店铺、安检）共用这一张表 —— 领域上是同一种东西，只是几何不同。",
    "_principle": [
      "★ 只有「影响寻路语义 / 搜索意图 / 图例符号」的差别才单独建类。",
      "  同一类东西的细分（零售 vs 免税 vs 便利店、ATM vs 银行）交给【名字 + fields】，不要造类。",
      "  原 65 个类已合并成 36 个。"
    ],
    "_why": "每个类下面的 _why 说明了它为什么值得单独存在。",
    "checkin": {
      "name": "值机柜台",
      "nameEn": "Check-in",
      "group": "process",
      "icon": "counter",
      "routeable": true,
      "_why": "旅客靠「A 岛」「CA」找柜台，字母编号和航司必须结构化",
      "fields": [
        {
          "key": "counterLetter",
          "label": "字母编号",
          "type": "string",
          "required": true,
          "pattern": "^[A-Z]{1,3}$",
          "index": true,
          "placeholder": "A",
          "hint": "值机岛/柜台的字母编号，例如 A、B、H。"
        },
        {
          "key": "airline",
          "label": "航空公司",
          "type": "airline",
          "required": true,
          "index": true,
          "hint": "这个柜台办哪家航司。填中文全称，编辑器会从航司表给建议。"
        },
        {
          "key": "airlineCode",
          "label": "航司代码",
          "type": "string",
          "required": true,
          "pattern": "^[A-Z0-9]{2,3}$",
          "index": true,
          "placeholder": "CA",
          "hint": "两字母 IATA 代码（CA / MU / CZ…）。搜索大小写不敏感。"
        }
      ]
    },
    "self_checkin": {
